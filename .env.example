# Pexels API for image/video fetching
PEXELS_API_KEY=your_pexels_api_key_here

# LLM providers for script generation. Free-tier quota is metered per
# (key, model), so every key set here adds independent headroom - the chain in
# script_service.py walks them in order until one answers. At least one is
# required; the rest are fallbacks that keep generation working when a
# provider's daily quota runs out.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_KEY_2=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
CEREBRAS_API_KEY=

# TTS Engine Selection
# Options: "polly" (AWS neural, most realistic), "gtts" (free, Google),
# "pyttsx3" (free, local), "elevenlabs" (premium, small free quota)
TTS_ENGINE=pyttsx3

# Amazon Polly (only needed if TTS_ENGINE=polly). Credentials come from the
# standard boto3 chain - on EC2 that means the instance's IAM role, so no keys
# belong here. The role needs polly:SynthesizeSpeech.
POLLY_REGION=ap-south-1
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural

# TTS Configuration
TTS_VOICE_NAME=default          # For pyttsx3: voice name (e.g., "Victoria", "David")
TTS_VOICE_ID=                   # For ElevenLabs: voice ID
TTS_RATE=150                    # Speech rate (75-300, default 150)
TTS_VOLUME=1.0                  # Volume (0.0-1.0)
TTS_LANGUAGE=en                 # Language code (en, es, fr, etc.)

# ElevenLabs API Key (only needed if TTS_ENGINE=elevenlabs)
# Get free credits at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Backblaze B2 (optional). If all four are set, finished videos are uploaded
# here and downloaded via a temporary signed link, instead of only living on
# local disk (which is wiped on every redeploy/restart on free hosting tiers).
# Leave unset to fall back to local-disk-only behavior.
#
# Setup: create a (private) bucket in the B2 dashboard, then create an
# "Application Key" restricted to that bucket. B2_ENDPOINT is the
# S3-compatible endpoint shown on the bucket's details page, e.g.
# https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=

# Signs login session cookies. Required. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
